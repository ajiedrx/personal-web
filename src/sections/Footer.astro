---
/**
 * Footer.astro — the closing footer section (Req 16).
 *
 * Renders (Req 16.1, 16.2):
 *  - A copyright notice containing the owner name. The name is Content_Store
 *    data (`profile.json` → `name`), the same source the Hero uses for the
 *    owner name (Req 16.1). The current year is computed at build time so the
 *    static output stays accurate for the year it was generated.
 *  - Quick links to each navigable section, mirroring the Navbar link set
 *    (Req 16.2). In-page anchors use plain `#hash` hrefs — they resolve
 *    relative to the current document and must not be base-prefixed (see
 *    `withBase`), consistent with the Hero and Navbar conventions.
 *
 * The section uses the semantic `<footer>` landmark (Req 18.1). All visible
 * chrome resolves through `t()` (Req 5.3, 5.5); the copyright label is built
 * from a localized template with the owner name and year interpolated in, so
 * both locales keep an identical key set.
 *
 * _Requirements: 16.1, 16.2_
 */
import type { Locale } from '../i18n/locale';
import { t } from '../i18n/locale';
import type { Profile } from '../content/types';
import profileData from '../content/profile.json';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Owner name is structured Content_Store data (Req 16.1), shared with the Hero.
const profile = profileData as Profile;
const { name: ownerName } = profile;

const currentYear = new Date().getFullYear();

/**
 * Quick links to the navigable sections (Req 16.2). Mirrors the Navbar link set
 * (`Navbar.astro`) so the footer and header stay in sync; `id` matches the
 * anchor id the locale pages assign (Task 19) and `labelKey` reuses the shared
 * `nav.*` labels. In-page hashes don't need the base prefix (see withBase).
 */
const QUICK_LINKS: ReadonlyArray<{ id: string; labelKey: string }> = [
  { id: 'about', labelKey: 'nav.about' },
  { id: 'expertise', labelKey: 'nav.expertise' },
  { id: 'experience', labelKey: 'nav.experience' },
  { id: 'projects', labelKey: 'nav.projects' },
  { id: 'impact', labelKey: 'nav.impact' },
  { id: 'education', labelKey: 'nav.education' },
  { id: 'contact', labelKey: 'nav.contact' },
];

// Localized copyright template with owner name + year interpolated (Req 16.1).
const copyright = t(locale, 'footer.copyright')
  .replace('{year}', String(currentYear))
  .replace('{name}', ownerName);

const quickLinksLabel = t(locale, 'footer.quickLinksLabel');
---

<footer class="footer" aria-labelledby="footer-heading">
  <div class="footer__inner">
    <nav class="footer__nav" aria-labelledby="footer-heading">
      <h2 id="footer-heading" class="footer__heading">{quickLinksLabel}</h2>
      <ul class="footer__links">
        {
          QUICK_LINKS.map((link) => (
            <li class="footer__item">
              <a class="footer__link" href={`#${link.id}`}>
                {t(locale, link.labelKey)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="footer__copyright" data-footer-copyright>{copyright}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-8, 3rem);
    padding-inline: var(--content-gutter);
    border-block-start: var(--border-width) solid var(--color-border, transparent);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6, 2rem);
    max-inline-size: var(--content-max-width);
    margin-inline: auto;
  }

  .footer__heading {
    margin: 0 0 var(--space-4, 1rem);
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--weight-medium, 500);
    letter-spacing: var(--tracking-wide, 0.05em);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4, 1rem) var(--space-6, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__item {
    margin: 0;
  }

  .footer__link {
    display: inline-block;
    padding-block: var(--space-1, 0.25rem);
    color: var(--color-text-muted);
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--weight-medium, 500);
    letter-spacing: var(--tracking-wide, 0.05em);
    text-decoration: none;
    text-transform: uppercase;
    border-block-end: var(--border-width-thick) solid transparent;
    transition:
      color var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard);
  }

  .footer__link:hover {
    color: var(--color-text);
    border-block-end-color: var(--color-accent);
  }

  .footer__copyright {
    margin: 0;
    font-size: var(--text-sm, 0.875rem);
    color: var(--color-text-muted);
  }

  /* Reduced motion: drop the link hover transitions (Req 18.7). */
  @media (prefers-reduced-motion: reduce) {
    .footer__link {
      transition: none;
    }
  }
</style>
