---
/**
 * MentorshipEducation.astro — the Mentorship & Education Section (Req 14).
 *
 * Renders three groups sourced from the Content_Store:
 *  - Mentorship entries (`src/content/mentorship.json`), each showing the
 *    title, organization, and date/year (Req 14.1, 14.3).
 *  - Education entries (`src/content/education.json`), each showing the title,
 *    organization, and year (Req 14.2, 14.3).
 *  - Featured certifications only, filtered via `featuredCertifications`
 *    (Req 14.4). Featured records render regardless of active/expired status
 *    (Req 14.7). Each featured certification shows its title, issuer, and issued
 *    year (Req 14.5). The expiry date and credential id are hidden unless the
 *    record opts in via `showDetails`; the `visibleCertificationDetails` helper
 *    computes which of those fields are visible (Req 14.6).
 *
 * All visible chrome strings resolve through the i18n helper `t()`. The section
 * owns the `#education` anchor the Navbar links to and uses semantic
 * `<section>` + `<h2>`/`<h3>` headings (the page owns the single `<h1>`)
 * — Req 3.3, 18.1.
 *
 * _Requirements: 14.1, 14.2, 14.3, 14.4, 14.5, 14.6, 14.7_
 */
import type { Locale } from '../i18n/locale';
import { t } from '../i18n/locale';
import { featuredCertifications, visibleCertificationDetails } from '../lib/content';
import type { MentorshipEntry, EducationEntry, CertificationEntry } from '../content/types';
import mentorshipData from '../content/mentorship.json';
import educationData from '../content/education.json';
import certificationsData from '../content/certifications.json';

interface Props {
  /** Active locale, used to resolve section chrome strings. */
  locale: Locale;
}

const { locale } = Astro.props;

// Content_Store entries. Certifications are filtered to featured-only,
// independent of active/expired status (Req 14.4, 14.7).
const mentorship = mentorshipData as MentorshipEntry[];
const education = educationData as EducationEntry[];
const certifications = featuredCertifications(certificationsData as CertificationEntry[]);

/** Extract the issued year from an ISO 'YYYY-MM' / 'YYYY' date (Req 14.5). */
function yearOf(value: string): string {
  const match = /^(\d{4})/.exec(value.trim());
  return match ? match[1]! : value;
}

// Precompute the visible detail fields per featured certification (Req 14.6).
const certViews = certifications.map((cert) => ({
  cert,
  issuedYear: yearOf(cert.issuedDate),
  details: visibleCertificationDetails(cert),
}));

const heading = t(locale, 'education.heading');
const mentorshipTitle = t(locale, 'education.mentorshipTitle');
const educationTitle = t(locale, 'education.educationTitle');
const certificationsTitle = t(locale, 'education.certificationsTitle');
const expiryLabel = t(locale, 'education.expiryLabel');
const credentialLabel = t(locale, 'education.credentialLabel');
---

<section id="education" class="education reveal" aria-labelledby="education-heading">
  <div class="education__inner">
    <h2 id="education-heading" class="education__heading">{heading}</h2>

    <div class="education__groups">
      {
        mentorship.length > 0 && (
          <div class="education__group">
            <h3 class="education__group-title">{mentorshipTitle}</h3>
            <ul class="education__list" role="list">
              {mentorship.map((entry) => (
                <li class="education__entry">
                  <p class="education__entry-title">{entry.title}</p>
                  <p class="education__entry-meta">
                    <span class="education__entry-org">{entry.organization}</span>
                    <span class="education__entry-date">{entry.date}</span>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        education.length > 0 && (
          <div class="education__group">
            <h3 class="education__group-title">{educationTitle}</h3>
            <ul class="education__list" role="list">
              {education.map((entry) => (
                <li class="education__entry">
                  <p class="education__entry-title">{entry.title}</p>
                  <p class="education__entry-meta">
                    <span class="education__entry-org">{entry.organization}</span>
                    <span class="education__entry-date">{entry.year}</span>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      {
        certViews.length > 0 && (
          <div class="education__group">
            <h3 class="education__group-title">{certificationsTitle}</h3>
            <ul class="education__list" role="list">
              {certViews.map(({ cert, issuedYear, details }) => (
                <li class="education__entry">
                  <p class="education__entry-title">{cert.title}</p>
                  <p class="education__entry-meta">
                    <span class="education__entry-org">{cert.issuer}</span>
                    <span class="education__entry-date">{issuedYear}</span>
                  </p>
                  {(details.expiryDate !== undefined || details.credentialId !== undefined) && (
                    <dl class="education__cert-details">
                      {details.expiryDate !== undefined && (
                        <div class="education__cert-detail">
                          <dt>{expiryLabel}</dt>
                          <dd>{details.expiryDate}</dd>
                        </div>
                      )}
                      {details.credentialId !== undefined && (
                        <div class="education__cert-detail">
                          <dt>{credentialLabel}</dt>
                          <dd>{details.credentialId}</dd>
                        </div>
                      )}
                    </dl>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .education {
    padding-block: var(--space-2xl, 4rem);
  }

  .education__inner {
    max-inline-size: var(--content-max-width, 72rem);
    margin-inline: auto;
    padding-inline: var(--content-gutter);
  }

  .education__heading {
    margin: 0 0 var(--space-lg, 1.5rem);
    font-size: var(--font-size-2xl, 1.75rem);
  }

  .education__groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-lg, 1.5rem);
  }

  .education__group {
    min-inline-size: 0;
  }

  .education__group-title {
    margin: 0 0 var(--space-md, 1rem);
    font-size: var(--font-size-lg, 1.125rem);
    letter-spacing: var(--tracking-wide, 0.05em);
    text-transform: uppercase;
    color: var(--color-text-muted, inherit);
  }

  .education__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--space-md, 1rem);
  }

  .education__entry {
    margin: 0;
  }

  .education__entry-title {
    margin: 0;
    font-weight: var(--weight-medium, 500);
    color: var(--color-text);
    /* Content-driven titles may hold long tokens; wrap so they never force
       horizontal overflow in the narrow group column at ~320px (Req 21.2). */
    overflow-wrap: anywhere;
  }

  .education__entry-meta {
    margin: 0.125rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, inherit);
    overflow-wrap: anywhere;
  }

  .education__entry-date::before {
    content: '·';
    margin-inline-end: 0.5rem;
  }

  .education__cert-details {
    margin: 0.375rem 0 0;
    display: grid;
    gap: 0.125rem;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, inherit);
  }

  .education__cert-detail {
    display: flex;
    gap: 0.375rem;
    margin: 0;
  }

  .education__cert-detail dt {
    margin: 0;
    font-weight: var(--weight-medium, 500);
  }

  .education__cert-detail dt::after {
    content: ':';
  }

  .education__cert-detail dd {
    margin: 0;
    /* Credential ids can be long unbroken tokens; wrap them so they never
       force horizontal overflow at narrow (~320px) viewports (Req 21.2). */
    min-inline-size: 0;
    overflow-wrap: anywhere;
  }
</style>
