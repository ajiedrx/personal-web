---
/**
 * FeaturedProjects.astro — the curated projects Section (Req 12).
 *
 * Sources curated projects from the Content_Store (`src/content/projects.json`)
 * and renders exactly one `ProjectCard` per *valid* project via `validProjects`
 * (Req 12.1). Records missing a required field (title, selling description,
 * 1–10 tech-stack chips, or a repository link) are omitted while the remaining
 * valid cards still render (Req 12.3, 12.4). Source order is preserved.
 *
 * Each card shows the title, selling description, tech-stack chips, and a
 * repository link, plus a demo link and screenshot only when the project
 * provides them (Req 12.6, 12.7, 12.8). The distinct hover state lives in the
 * `ProjectCard` scoped styles (Req 12.5).
 *
 * All visible chrome strings resolve through the i18n helper `t()`; the
 * per-card screenshot alt text substitutes the project title into the localized
 * template.
 *
 * _Requirements: 12.1, 12.3, 12.4, 12.5, 12.6, 12.7, 12.8_
 */
import type { Locale } from '../i18n/locale';
import { t } from '../i18n/locale';
import { validProjects } from '../lib/content';
import type { Project } from '../content/types';
import projectsData from '../content/projects.json';
import ProjectCard from '../components/ProjectCard.astro';

interface Props {
  /** Active locale, used to resolve section chrome strings. */
  locale: Locale;
}

const { locale } = Astro.props;

// Keep only valid curated projects, preserving source order (Req 12.1, 12.4).
const projects = validProjects(projectsData as Partial<Project>[]);

const heading = t(locale, 'projects.heading');
const intro = t(locale, 'projects.intro');
const repoLabel = t(locale, 'projects.repoLabel');
const demoLabel = t(locale, 'projects.demoLabel');
const screenshotAltTemplate = t(locale, 'projects.screenshotAlt');

/** Substitute a project title into the localized screenshot alt template. */
function screenshotAltFor(title: string): string {
  return screenshotAltTemplate.replace('{title}', title);
}
---

<section id="projects" class="projects reveal" aria-labelledby="projects-heading">
  <div class="projects__inner">
    <h2 id="projects-heading" class="projects__heading">{heading}</h2>
    <p class="projects__intro">{intro}</p>

    <ul class="projects__grid" role="list">
      {
        projects.map((project) => (
          <li class="projects__item">
            <ProjectCard
              project={project}
              repoLabel={repoLabel}
              demoLabel={demoLabel}
              screenshotAlt={screenshotAltFor(project.title)}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .projects {
    padding-block: var(--space-2xl, 4rem);
  }

  .projects__inner {
    max-inline-size: var(--content-max-width, 72rem);
    margin-inline: auto;
    padding-inline: var(--content-gutter);
  }

  .projects__heading {
    margin: 0 0 var(--space-2, 0.5rem);
    font-size: var(--font-size-2xl, 1.75rem);
  }

  .projects__intro {
    margin: 0 0 var(--space-lg, 1.5rem);
    color: var(--color-text-muted, inherit);
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-lg, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .projects__item {
    display: flex;
  }

  /* The card stretches to fill its grid cell for even row heights. */
  .projects__item > :global(.project-card) {
    inline-size: 100%;
  }
</style>
