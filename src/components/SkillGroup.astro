---
/**
 * SkillGroup.astro — a single skill-category group for the Expertise section.
 *
 * Renders one of the four fixed skill categories (Core Mobile, Full-Stack,
 * Modern Tech, Quality) with its localized category label and the list of
 * skill entries assigned to it (Req 10.1, 10.3). The group's label resolves
 * through the i18n helper `t()` via the group's `labelKey`; the skill entries
 * are structured, language-neutral Content_Store data passed in by the parent
 * Expertise section (Req 10.2).
 *
 * Each group is a semantic list under an `<h3>` (the section owns the `<h2>`,
 * the page owns the single `<h1>`) so heading levels are not skipped (Req 18.1).
 *
 * _Requirements: 10.1, 10.2, 10.3_
 */
import type { Locale } from '../i18n/locale';
import { t } from '../i18n/locale';
import type { SkillGroup } from '../content/types';

interface Props {
  /** The skill group to render (category, localized label key, and entries). */
  group: SkillGroup;
  /** Active locale, used to resolve the category label. */
  locale: Locale;
}

const { group, locale } = Astro.props;

const label = t(locale, group.labelKey);
// Stable id derived from the fixed category, used to associate the group's
// heading with its skill list for assistive technology.
const headingId = `skill-group-${group.category}`;
---

<article
  class="skill-group"
  data-skill-group={group.category}
  aria-labelledby={headingId}
>
  <h3 id={headingId} class="skill-group__label">{label}</h3>
  <ul class="skill-group__skills" role="list">
    {
      group.skills.map((skill) => (
        <li class="skill-group__skill" data-skill>
          {skill}
        </li>
      ))
    }
  </ul>
</article>

<style>
  .skill-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-4, 1rem);
    padding: var(--space-5, 1.5rem);
    border: var(--border-width, 1px) solid var(--color-border);
    border-radius: var(--radius-md, 0.375rem);
    background: var(--color-surface);
  }

  .skill-group__label {
    margin: 0;
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--weight-semibold, 600);
    letter-spacing: var(--tracking-wide, 0.04em);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .skill-group__skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-group__skill {
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-1, 0.25rem);
    padding-inline: var(--space-3, 0.75rem);
    border: var(--border-width, 1px) solid var(--color-border);
    border-radius: var(--radius-pill, 999px);
    font-size: var(--text-sm, 0.875rem);
    font-weight: var(--weight-medium, 500);
    color: var(--color-text);
  }
</style>
