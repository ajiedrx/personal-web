---
/**
 * TimelineEntry.astro — a single career entry in the Experience timeline.
 *
 * Renders the role, organization, formatted date range, and the entry's
 * highlights (Req 11.2). The date range renders `startDate – endDate`, with an
 * open-ended entry (`endDate === null`) shown as "Present" using the localized
 * label passed by the parent section (Req 11.2). Formatting/ordering of the
 * timeline itself is the section's concern (via `sortExperienceDesc`); this
 * component is presentation-only.
 *
 * _Requirements: 11.2_
 */
import type { ExperienceEntry } from '../content/types';

interface Props {
  /** The experience entry to render. */
  entry: ExperienceEntry;
  /** Localized label used when `endDate === null` (e.g. "Present" / "Sekarang"). */
  presentLabel: string;
}

const { entry, presentLabel } = Astro.props;

/**
 * Format an ISO 'YYYY-MM' (or 'YYYY') date into a human-friendly label.
 * Falls back to the raw string when it is not a parseable year/month.
 */
function formatDate(value: string): string {
  const match = /^(\d{4})(?:-(\d{2}))?$/.exec(value.trim());
  if (match === null) return value;

  const [, year, month] = match;
  if (month === undefined) return year!;

  const monthIndex = Number(month) - 1;
  const MONTHS = [
    'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
    'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
  ];
  const monthLabel = MONTHS[monthIndex];
  return monthLabel === undefined ? value : `${monthLabel} ${year}`;
}

const startLabel = formatDate(entry.startDate);
const endLabel = entry.endDate === null ? presentLabel : formatDate(entry.endDate);
const dateRange = `${startLabel} – ${endLabel}`;
---

<li class="timeline-entry">
  <div class="timeline-entry__marker" aria-hidden="true"></div>
  <div class="timeline-entry__body">
    <div class="timeline-entry__head">
      <h3 class="timeline-entry__role">{entry.role}</h3>
      <p class="timeline-entry__org">{entry.organization}</p>
    </div>
    <p class="timeline-entry__dates">
      <time>{startLabel}</time> – {
        entry.endDate === null ? presentLabel : <time>{endLabel}</time>
      }
    </p>
    {
      entry.highlights.length > 0 && (
        <ul class="timeline-entry__highlights">
          {entry.highlights.map((highlight) => (
            <li>{highlight}</li>
          ))}
        </ul>
      )
    }
  </div>
</li>

<style>
  .timeline-entry {
    position: relative;
    padding-left: var(--space-lg, 1.5rem);
    padding-bottom: var(--space-lg, 1.5rem);
    border-left: 2px solid var(--color-border, currentColor);
    list-style: none;
  }

  .timeline-entry:last-child {
    padding-bottom: 0;
  }

  .timeline-entry__marker {
    position: absolute;
    left: -0.4375rem;
    top: 0.375rem;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-accent, #ff5a1f);
  }

  .timeline-entry__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }

  .timeline-entry__role {
    margin: 0;
    font-size: var(--font-size-lg, 1.125rem);
    line-height: 1.3;
  }

  .timeline-entry__org {
    margin: 0;
    color: var(--color-text-muted, inherit);
  }

  .timeline-entry__dates {
    margin: 0.25rem 0 0.5rem;
    font-size: var(--font-size-sm, 0.875rem);
    color: var(--color-text-muted, inherit);
  }

  .timeline-entry__highlights {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: 0.25rem;
  }
</style>
